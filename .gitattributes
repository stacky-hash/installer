# Authored on Windows, run on Linux: a CRLF in the shebang makes the binary
# unrunnable with "bad interpreter", whatever the committer's core.autocrlf.
* text=auto eol=lf
*.png binary
*.jpg binary

# Keep development files out of the dist archive. This is installed globally,
# alongside every other global tool, so it ships only what it runs.
/tests export-ignore
/phpunit.xml export-ignore
/pint.json export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
