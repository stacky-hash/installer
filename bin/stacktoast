#!/usr/bin/env php
<?php

/**
 * The `stacktoast` entry point.
 *
 * Everything above the autoloader is written to parse on any PHP, so that a
 * machine too old to run this package is told so rather than shown a syntax
 * error. Composer refuses the install on an old PHP with a message of its
 * own; this covers the person who cloned the repository instead.
 */

$minimum = '8.4.0';

if (version_compare(PHP_VERSION, $minimum, '<')) {
    fwrite(STDERR, PHP_EOL);
    fwrite(STDERR, '  Stack Toast needs PHP '.$minimum.' or newer. This is PHP '.PHP_VERSION.'.'.PHP_EOL);
    fwrite(STDERR, '  https://stacktoast.com'.PHP_EOL);
    fwrite(STDERR, PHP_EOL);

    exit(1);
}

$autoloaders = array(
    // Cloned and installed on its own.
    __DIR__.'/../vendor/autoload.php',
    // Installed as a dependency, including by `composer global require`.
    __DIR__.'/../../../autoload.php',
);

$loaded = false;

foreach ($autoloaders as $autoloader) {
    if (file_exists($autoloader)) {
        require $autoloader;
        $loaded = true;
        break;
    }
}

if (! $loaded) {
    fwrite(STDERR, PHP_EOL);
    fwrite(STDERR, '  Dependencies are missing. Run `composer install` in '.dirname(__DIR__).'.'.PHP_EOL);
    fwrite(STDERR, PHP_EOL);

    exit(1);
}

exit((new StackToast\Installer\Application)->run());
